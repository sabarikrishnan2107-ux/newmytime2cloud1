

# Dependencies (installed via npm/composer, never committed)
**/node_modules/
**/vendor/

# Build output
**/.next/
**/out/
**/dist/
**/.vite/

# Bundled runtimes & binaries (present locally for packaging, not versioned)
**/*.exe
**/*.dll

# License signing keys — NEVER commit (private key must stay off git)
**/storage/license/

# Editor / local agent config
.claude/settings.json


# Camera service AI model files (large binary, download separately)
camera-service/models/models/
*.onnx
*.zip

# Environment files (NEVER commit secrets)
.env
.env.live
.env.local
.env.production
.env.development
.env.staging
**/.env
**/.env.live
**/.env.local
**/.env.production
**/.env.development
**/.env.staging

# Electron desktop shell (do not commit deps/binaries)
electron/node_modules/

# nginx runtime artifacts (conf/ + nginx.exe ARE committed, like the bundled PHP;
# these are generated at runtime by the desktop shell)
logs/
temp/

# Runtime-generated logs (regenerated on each run, never versioned)
**/*.log
sdk/dotnet/Log/

# Python bytecode / venvs (services/face source IS committed; these are not)
__pycache__/
*.pyc
services/face/venv/
services/face/.venv/

# Bundled JRE jimage — exceeds GitHub's 100MB file limit; present locally for packaging, not versioned
sdk/java/lib/modules

# Large DB backup dump — kept locally, not versioned
backend/database/mytime-backup-25-march.sql

# OS
.DS_Store
Thumbs.db
conf/nginx.runtime.conf
nginx.runtime.conf
