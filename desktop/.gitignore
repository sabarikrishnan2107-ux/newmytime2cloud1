# Electron desktop shell (do not commit deps/binaries)
electron/node_modules/

# Bundled device SDK runtimes (large binaries: .NET + JRE), now under sdk/
sdk/dotnet/
sdk/java/

# nginx runtime artifacts (conf/ + nginx.exe ARE committed, like the bundled PHP;
