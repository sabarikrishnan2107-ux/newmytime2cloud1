# Camera service AI model files (large binary, download separately)
camera-service/models/models/
*.onnx
*.zip

# Environment files (NEVER commit secrets)
.env
.env.live
.env.local
.env.production
.env.development
.env.staging
**/.env
**/.env.live
**/.env.local
**/.env.production
