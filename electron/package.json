{
  "name": "mytime2desktop",
  "version": "19.06.2026",
  "private": true,
  "description": "Electron desktop shell for MyTime2Desktop",
  "author": "MyTime2Desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "42.3.3",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.mytime2.desktop",
    "productName": "MyTime2Desktop",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "main.js",
      "config.js",
      "postgres.js",
      "preload.js",
      "settings.html",
      "logs.html",
      "license.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../pgsql",
        "to": "pgsql"
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!database/mytime-backup-25-march.sql",
          "!tests/**",
          "!storage/logs/*.log"
        ]
      },
      {
        "from": "../sdk",
        "to": "sdk",
        "filter": [
          "**/*",
          "!dotnet/dotnet/sdk/**",
          "!dotnet/dotnet/sdk-manifests/**",
          "!dotnet/dotnet/packs/**",
          "!dotnet/dotnet/templates/**",
          "!java/jmods/**"
        ]
      },
      {
        "from": "../services",
        "to": "services",
        "filter": [
          "**/*",
          "!face/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../conf",
        "to": "conf"
      },
      {
        "from": "../nginx.exe",
        "to": "nginx.exe"
      },
      {
        "from": "../frontend/out",
        "to": "frontend/out"
      },
      {
        "from": "../allow-lan-access.bat",
        "to": "allow-lan-access.bat"
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MyTime2Desktop-Setup-19.06.2026.${ext}"
    }
  }
}
